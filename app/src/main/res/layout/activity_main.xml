<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor raíz: ocupa toda la pantalla -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Columna vertical con las dos filas. Su id "main" lo usa la plantilla para los márgenes del sistema -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- FILA 1: euros -> dólares -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Caja donde se escribe la cantidad en euros (peso 2: la más ancha) -->
            <EditText
                android:id="@+id/editTextEuros"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:autofillHints=""
                android:ems="10"
                android:inputType="numberDecimal" />

            <!-- Símbolo € (peso 0: solo ocupa lo justo) -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="@string/euro_symbol" />

            <!-- Botón: al pulsarlo se ejecuta onClickToDollars() de MainActivity -->
            <Button
                android:id="@+id/buttonToDollars"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="onClickToDollars"
                android:text="@string/button_to_dollars" />
        </LinearLayout>

        <!-- FILA 2: dólares -> euros -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editTextDollars"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:autofillHints=""
                android:ems="10"
                android:inputType="numberDecimal" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="@string/dollar_symbol" />

            <Button
                android:id="@+id/buttonToEuros"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="onClickToEuros"
                android:text="@string/button_to_euros" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>